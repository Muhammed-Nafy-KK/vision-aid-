GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-2.0-flash-lite
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
OPENAI_API_KEYS=your_openai_key_1,your_openai_key_2
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o-mini
DEEPSEEK_API_KEYS=your_deepseek_key_1,your_deepseek_key_2
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_VISION_MODEL=
PROVIDER_ORDER=gemini,openai,deepseek
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_COUNTRYCODES=in
NOMINATIM_CONTACT_EMAIL=
NOMINATIM_USER_AGENT=BlindAssist/1.0
DEVICE_PROFILE=pc
CAMERA_INDEX=0
CAMERA_BACKEND=auto
FRAME_WIDTH=640
FRAME_HEIGHT=480
CAMERA_READ_INTERVAL_SECONDS=0.03
LIVE_INTERVAL_SECONDS=2.5
ASSIST_INTERVAL_SECONDS=3.0
ENABLE_LIVE_MODE=true
WHISPER_MODEL=base
WHISPER_BEAM_SIZE=3
SAMPLE_RATE=16000
INITIAL_LISTEN_SECONDS=2.2
EXTENDED_LISTEN_SECONDS=3.8
COMMAND_RECORD_SECONDS=4
AMBIENT_ADJUST_SECONDS=0.6
LISTEN_TIMEOUT_SECONDS=3.0
PAUSE_THRESHOLD=0.8
NON_SPEAKING_DURATION=0.3
PHRASE_THRESHOLD=0.2
WAKE_WORD=hi
WAKE_WORD_SIMILARITY=0.72
COMMAND_SIMILARITY=0.76
TTS_RATE=180
PREFERRED_OUTPUT_NAME=headphones (realtek hd audio 2nd output)
PREFERRED_OUTPUT_KEYWORDS=headphones,realtek hd audio 2nd output,earphone
EXCLUDED_OUTPUT_KEYWORDS=bluetooth,airpods,hands-free,headset
PREFERRED_INPUT_KEYWORDS=usb2.0 device,usb microphone,usb mic,microphone
EXCLUDED_INPUT_KEYWORDS=logitech,webcam,c925,c920
EMERGENCY_CONTACT_NAME=
EMERGENCY_CONTACT_PHONE=
EMERGENCY_OUTPUT_DIR=alerts
