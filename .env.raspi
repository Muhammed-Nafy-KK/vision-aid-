DEVICE_PROFILE=pi3

GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-2.0-flash-lite
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

OPENAI_API_KEYS=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o-mini

DEEPSEEK_API_KEYS=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_VISION_MODEL=

PROVIDER_ORDER=gemini,openai,deepseek

NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_COUNTRYCODES=in
NOMINATIM_CONTACT_EMAIL=
NOMINATIM_USER_AGENT=BlindAssist/1.0

CAMERA_INDEX=0
CAMERA_BACKEND=v4l2
FRAME_WIDTH=320
FRAME_HEIGHT=240
CAMERA_READ_INTERVAL_SECONDS=0.08

LIVE_INTERVAL_SECONDS=5.0
ASSIST_INTERVAL_SECONDS=4.5
ENABLE_LIVE_MODE=false

WHISPER_MODEL=tiny
WHISPER_BEAM_SIZE=1
SAMPLE_RATE=16000
INITIAL_LISTEN_SECONDS=2.2
EXTENDED_LISTEN_SECONDS=4.5
COMMAND_RECORD_SECONDS=5
AMBIENT_ADJUST_SECONDS=0.8
LISTEN_TIMEOUT_SECONDS=4.0
PAUSE_THRESHOLD=0.8
NON_SPEAKING_DURATION=0.3
PHRASE_THRESHOLD=0.2

WAKE_WORD=hi
WAKE_WORD_SIMILARITY=0.72
COMMAND_SIMILARITY=0.76
TTS_RATE=170

PREFERRED_OUTPUT_NAME=
PREFERRED_OUTPUT_KEYWORDS=headphone,headset,earphone
EXCLUDED_OUTPUT_KEYWORDS=bluetooth,airpods,hands-free
PREFERRED_INPUT_KEYWORDS=usb microphone,usb mic,microphone
EXCLUDED_INPUT_KEYWORDS=webcam,logitech

EMERGENCY_CONTACT_NAME=
EMERGENCY_CONTACT_PHONE=
EMERGENCY_OUTPUT_DIR=alerts
PROFILE_OVERRIDE_DEFAULTS=true
